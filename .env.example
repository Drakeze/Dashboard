# MongoDB connection string for Prisma — use a distinct database name within
# your existing cluster, e.g. .../dashboard
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/dashboard?retryWrites=true&w=majority"

# better-auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Single-admin allowlist — must match the email you sign up/sign in with via better-auth
ADMIN_EMAIL="you@example.com"
